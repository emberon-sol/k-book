<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>K Book - บันทึกการเงินส่วนตัว</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Supabase JS Client -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <!-- Google Font: Kanit -->
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Kanit', sans-serif; }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 pb-24">

    <!-- Header -->
    <header class="bg-indigo-600 text-white p-4 shadow-md sticky top-0 z-50 flex justify-between items-center">
        <h1 class="text-lg font-bold flex items-center gap-2">📖 K Book</h1>
        <div id="auth-header-action"></div>
    </header>

    <!-- Main Container -->
    <main class="max-w-md mx-auto p-4 space-y-4">

        <!-- 1. หน้าจอ Login / Register -->
        <div id="auth-section" class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 mt-10">
            <h2 id="auth-title" class="text-xl font-bold text-slate-800 mb-1 text-center">เข้าสู่ระบบ K Book</h2>
            <p class="text-xs text-slate-400 text-center mb-6">ระบบจัดการการเงินและบัญชีบนคลาวด์</p>
            
            <form id="auth-form" class="space-y-3">
                <div>
                    <label class="text-xs text-slate-500">อีเมล</label>
                    <input type="email" id="auth-email" required class="w-full mt-1 p-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-indigo-500" placeholder="name@email.com">
                </div>
                <div>
                    <label class="text-xs text-slate-500">รหัสผ่าน</label>
                    <input type="password" id="auth-password" required class="w-full mt-1 p-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-indigo-500" placeholder="••••••••">
                </div>
                <button type="submit" id="auth-btn" class="w-full py-3 bg-indigo-600 text-white font-medium rounded-xl shadow-md hover:bg-indigo-700 transition">เข้าสู่ระบบ</button>
            </form>

            <div class="text-center mt-4">
                <button type="button" onclick="toggleAuthMode()" id="auth-toggle-btn" class="text-xs text-indigo-600 hover:underline">ยังไม่มีบัญชี? สมัครสมาชิกใหม่</button>
            </div>
        </div>

        <!-- 2. แอปพลิเคชันหลัก (แสดงหลัง Login) -->
        <div id="app-section" class="space-y-4 hidden">
            
            <!-- ยอดสุทธิรวม -->
            <div class="bg-gradient-to-r from-indigo-600 to-violet-600 text-white p-5 rounded-2xl shadow-lg">
                <p class="text-xs opacity-90">ยอดสุทธิรวมทุกกระเป๋า</p>
                <h2 id="total-balance" class="text-3xl font-bold mt-1">0.00 ฿</h2>
            </div>

            <!-- ฟอร์มบันทึกรายการ -->
            <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-200">
                <h3 class="font-semibold text-slate-700 mb-3 text-sm">✍️ บันทึกรายการใหม่</h3>
                <form id="transaction-form" class="space-y-3">
                    <div class="grid grid-cols-2 gap-2">
                        <button type="button" id="btn-expense" onclick="setTxType('expense')" class="py-2 text-xs font-medium rounded-xl border border-rose-200 text-rose-600 bg-rose-50 transition">รายจ่าย (-)</button>
                        <button type="button" id="btn-income" onclick="setTxType('income')" class="py-2 text-xs font-medium rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-50 transition">รายรับ (+)</button>
                    </div>
                    <div>
                        <label class="text-xs text-slate-500">กระเป๋าเงิน</label>
                        <select id="tx-wallet" required class="w-full mt-1 p-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-indigo-500">
                            <option value="">-- กรุณาเพิ่มกระเป๋าเงินก่อน --</option>
                        </select>
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="text-xs text-slate-500">จำนวนเงิน</label>
                            <input type="number" id="amount" step="any" required class="w-full mt-1 p-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold" placeholder="0.00">
                        </div>
                        <div>
                            <label class="text-xs text-slate-500">หมวดหมู่</label>
                            <input type="text" id="category" required class="w-full mt-1 p-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm" placeholder="เช่น อาหาร">
                        </div>
                    </div>
                    <div>
                        <label class="text-xs text-slate-500">บันทึกช่วยจำ</label>
                        <input type="text" id="note" class="w-full mt-1 p-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm" placeholder="รายละเอียดเพิ่มเติม">
                    </div>
                    <button type="submit" class="w-full py-2.5 bg-indigo-600 text-white text-sm font-medium rounded-xl shadow-md hover:bg-indigo-700 transition">เพิ่มรายการ</button>
                </form>
            </div>

            <!-- จัดการกระเป๋าเงินเบื้องต้น -->
            <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-200">
                <h3 class="font-semibold text-slate-700 mb-3 text-sm">👛 เพิ่มกระเป๋าเงิน</h3>
                <form id="wallet-form" class="space-y-3">
                    <div class="grid grid-cols-2 gap-2">
                        <input type="text" id="wallet-name" required class="p-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm" placeholder="ชื่อกระเป๋า (เช่น KBANK)">
                        <input type="number" id="wallet-balance" step="any" required class="p-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm" placeholder="ยอดเริ่มต้น">
                    </div>
                    <button type="submit" class="w-full py-2 bg-slate-800 text-white text-xs font-medium rounded-xl">สร้างกระเป๋าเงิน</button>
                </form>
                <div id="wallet-list" class="mt-3 space-y-2"></div>
            </div>

            <!-- ประวัติรายการล่าสุด -->
            <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-200">
                <h3 class="font-semibold text-slate-700 mb-3 text-sm">📋 ประวัติรายการ</h3>
                <div id="transaction-list" class="space-y-2">
                    <p class="text-xs text-slate-400 text-center py-4">ยังไม่มีรายการ</p>
                </div>
            </div>

        </div>

    </main>

    <!-- Navigation Bar ด้านล่าง -->
    <nav class="fixed bottom-0 left-0 right-0 bg-white border-t border-slate-200 py-2 px-4 shadow-lg z-50">
        <div class="max-w-md mx-auto flex justify-around text-center text-xs text-slate-500">
            <button onclick="switchTab('home')" class="flex flex-col items-center text-indigo-600 font-medium">
                <span>🏠</span><span>บันทึก</span>
            </button>
        </div>
    </nav>

    <!-- JavaScript ระบบเชื่อมต่อ Supabase -->
    <script>
        const SUPABASE_URL = 'https://zdujaukypdsapfnbxjcv.supabase.co';
        const SUPABASE_ANON_KEY = 'sb_publishable_ELoT40vHobIaY4FVaFU5XA_77TNmyWc';
        
        const { createClient } = supabase;
        const _supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

        let currentType = 'expense';
        let isSignUpMode = false;
        let currentUser = null;

        function toggleAuthMode() {
            isSignUpMode = !isSignUpMode;
            document.getElementById('auth-title').innerText = isSignUpMode ? 'สมัครสมาชิก K Book' : 'เข้าสู่ระบบ K Book';
            document.getElementById('auth-btn').innerText = isSignUpMode ? 'สมัครสมาชิก' : 'เข้าสู่ระบบ';
            document.getElementById('auth-toggle-btn').innerText = isSignUpMode ? 'มีบัญชีอยู่แล้ว? เข้าสู่ระบบ' : 'ยังไม่มีบัญชี? สมัครสมาชิกใหม่';
        }

        function setTxType(type) {
            currentType = type;
            const btnExp = document.getElementById('btn-expense');
            const btnInc = document.getElementById('btn-income');
            if(type === 'expense') {
                btnExp.className = "py-2 text-xs font-medium rounded-xl border border-rose-200 text-rose-600 bg-rose-50 transition";
                btnInc.className = "py-2 text-xs font-medium rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-50 transition";
            } else {
                btnInc.className = "py-2 text-xs font-medium rounded-xl border border-emerald-200 text-emerald-600 bg-emerald-50 transition";
                btnExp.className = "py-2 text-xs font-medium rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-50 transition";
            }
        }

        document.getElementById('auth-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const email = document.getElementById('auth-email').value;
            const password = document.getElementById('auth-password').value;

            if (isSignUpMode) {
                const { error } = await _supabase.auth.signUp({ email, password });
                if (error) alert('สมัครสมาชิกไม่สำเร็จ: ' + error.message);
                else { alert('สมัครสำเร็จ! เข้าสู่ระบบได้เลย'); isSignUpMode = false; toggleAuthMode(); }
            } else {
                const { error } = await _supabase.auth.signInWithPassword({ email, password });
                if (error) alert('เข้าสู่ระบบไม่สำเร็จ: ' + error.message);
                else { checkUserSession(); }
            }
        });

        async function checkUserSession() {
            const { data: { session } } = await _supabase.auth.getSession();
            currentUser = session?.user || null;
            
            if (currentUser) {
                document.getElementById('auth-section').classList.add('hidden');
                document.getElementById('app-section').classList.remove('hidden');
                document.getElementById('auth-header-action').innerHTML = `<button onclick="logout()" class="text-xs bg-indigo-700 px-3 py-1.5 rounded-lg shadow">ออกจากระบบ</button>`;
                loadAllData();
            } else {
                document.getElementById('auth-section').classList.remove('hidden');
                document.getElementById('app-section').classList.add('hidden');
                document.getElementById('auth-header-action').innerHTML = '';
            }
        }

        async function logout() {
            await _supabase.auth.signOut();
            checkUserSession();
        }

        async function loadAllData() {
            await loadWallets();
            await loadTransactions();
        }

        // --- WALLETS ---
        document.getElementById('wallet-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const name = document.getElementById('wallet-name').value;
            const balance = parseFloat(document.getElementById('wallet-balance').value);

            const { error } = await _supabase.from('wallets').insert([{ user_id: currentUser.id, name, balance }]);
            if (error) alert('เพิ่มกระเป๋าไม่สำเร็จ: ' + error.message);
            else {
                document.getElementById('wallet-name').value = '';
                document.getElementById('wallet-balance').value = '';
                loadAllData();
            }
        });

        async function loadWallets() {
            const { data } = await _supabase.from('wallets').select('*');
            const selectEl = document.getElementById('tx-wallet');
            const listEl = document.getElementById('wallet-list');
            
            if (!data || data.length === 0) {
                selectEl.innerHTML = `<option value="">-- กรุณาเพิ่มกระเป๋าเงินก่อน --</option>`;
                listEl.innerHTML = `<p class="text-xs text-slate-400 text-center py-2">ยังไม่มีกระเป๋าเงิน</p>`;
                document.getElementById('total-balance').innerText = '0.00 ฿';
                return;
            }

            let optHtml = '';
            let listHtml = '';
            let total = 0;

            data.forEach(w => {
                total += Number(w.balance);
                optHtml += `<option value="${w.id}">${w.name} (${Number(w.balance).toLocaleString()} ฿)</option>`;
                listHtml += `
                    <div class="flex justify-between items-center p-2.5 bg-slate-50 rounded-xl border border-slate-100 text-xs">
                        <span class="font-medium text-slate-700">${w.name}</span>
                        <span class="font-semibold text-indigo-600">${Number(w.balance).toLocaleString()} ฿</span>
                    </div>
                `;
            });

            selectEl.innerHTML = optHtml;
            listEl.innerHTML = listHtml;
            document.getElementById('total-balance').innerText = total.toLocaleString() + ' ฿';
        }

        // --- TRANSACTIONS ---
        document.getElementById('transaction-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const wallet_id = document.getElementById('tx-wallet').value;
            const amount = parseFloat(document.getElementById('amount').value);
            const category = document.getElementById('category').value;
            const note = document.getElementById('note').value;

            if (!wallet_id) { alert('กรุณาเลือกกระเป๋าเงิน'); return; }

            const { error } = await _supabase.from('transactions').insert([{ user_id: currentUser.id, wallet_id, type: currentType, amount, category, note }]);
            if (error) { alert('บันทึกไม่สำเร็จ: ' + error.message); return; }

            const { data: walletData } = await _supabase.from('wallets').select('balance').eq('id', wallet_id).single();
            let newBalance = currentType === 'income' ? Number(walletData.balance) + amount : Number(walletData.balance) - amount;

            await _supabase.from('wallets').update({ balance: newBalance }).eq('id', wallet_id);

            document.getElementById('amount').value = '';
            document.getElementById('category').value = '';
            document.getElementById('note').value = '';
            loadAllData();
        });

        async function loadTransactions() {
            const { data } = await _supabase.from('transactions').select('*').order('created_at', { ascending: false });
            const listEl = document.getElementById('transaction-list');

            if (!data || data.length === 0) {
                listEl.innerHTML = `<p class="text-xs text-slate-400 text-center py-4">ยังไม่มีรายการ</p>`;
                return;
            }

            let html = '';
            data.forEach(tx => {
                const isInc = tx.type === 'income';
                html += `
                    <div class="flex justify-between items-center p-3 bg-slate-50 rounded-xl border border-slate-100 text-xs">
                        <div>
                            <p class="font-medium text-slate-700 text-sm">${tx.category}</p>
                            <p class="text-slate-400">${tx.note || '-'}</p>
                        </div>
                        <span class="font-semibold text-sm ${isInc ? 'text-emerald-600' : 'text-rose-600'}">
                            ${isInc ? '+' : '-'}${Number(tx.amount).toLocaleString()} ฿
                        </span>
                    </div>
                `;
            });
            listEl.innerHTML = html;
        }

        checkUserSession();
    </script>
</body>
</html>
